# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# Vault the agent reads and writes (Obsidian folder). Use a dev copy while building.
WIKI_VAULT_PATH=~/WorkDev
# Where task IDs live (decision 0001). Only "inline" is built.
WIKI_TASK_IDS=inline

# Default model, "provider:model". A run's context `model` (e.g. a Studio assistant) overrides it.
#   ollama:llama3.1:8b                       local, needs `ollama serve` (OLLAMA_HOST for another server)
#   anthropic:claude-haiku-5-5               needs ANTHROPIC_API_KEY  (alias: claude:...)
#   openrouter:openai/gpt-5-mini             needs OPENROUTER_API_KEY
# Other providers: `uv add langchain-<provider>`, then e.g. openai:..., google_genai:...
WIKI_MODEL=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
