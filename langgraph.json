{
  "$schema": "https://langgra.ph/schema.json",
  "python_version": "3.12",
  "image_distro": "wolfi",
  "source": {
    "kind": "uv"
  },
  "dockerfile_lines": [
    "ENV UV_NO_DEV=1",
    "RUN apk add --no-cache tzdata"
  ],
  "graphs": {
    "ingest": "./src/llm_wiki/ingest/graph.py:graph",
    "assistant": "./src/llm_wiki/assistant/graph.py:make_graph",
    "rollover": "./src/llm_wiki/rollover_graph.py:graph"
  },
  "env": ".env",
  "http": {
    "app": "./src/llm_wiki/review_web/app.py:app",
    "cors": {
      "allow_origins": [
        "https://smith.langchain.com"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "allow_headers": [
        "*"
      ],
      "expose_headers": [
        "x-pagination-total",
        "x-pagination-next",
        "content-location"
      ]
    }
  }
}
